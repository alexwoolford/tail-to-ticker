# Installed at /opt/tail-to-ticker/etc/tail-to-ticker.env
# Copied by deploy/install.sh if missing. Fill SEC_USER_AGENT on the host (chmod 600).
# Never commit a populated copy. Do not put OpenSky or ADS-B keys here.

RUST_LOG=info
TAIL_TO_TICKER_BIN=/opt/tail-to-ticker/bin/tail-to-ticker
TAIL_TO_TICKER_DATA=/var/lib/tail-to-ticker/work
TAIL_TO_TICKER_CACHE=/var/lib/tail-to-ticker/cache

# Descriptive contact for SEC / PUDL fetches. Must not contain example.com.
# SEC sample shape (this 200s; github-paren form 403s as undeclared):
#   tail-to-ticker you@domain
SEC_USER_AGENT=

# Published faa-registry-mirror sqlite (current MASTER + ACFTREF). Not a zip GET.
FAA_REGISTRY_DB=/var/lib/faa-registry-mirror/current/faa-registry.sqlite

# Do not set HTTPS_PROXY to the existing IPRoyal HTTP(S) product: CONNECT to
# registry.faa.gov and www.sec.gov returns 403 from that proxy. If a future
# proxy allows those hosts, set HTTPS_PROXY here (chmod 600) and keep S3 off it:
# NO_PROXY=amazonaws.com,.amazonaws.com,s3.us-west-2.amazonaws.com
# PUDL Exhibit 21 is fetched with reqwest no_proxy regardless.

